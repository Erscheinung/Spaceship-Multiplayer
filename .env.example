# Optional custom PeerJS signaling server. The public PeerJS cloud is the default.
PUBLIC_PEER_HOST=
PUBLIC_PEER_PORT=443
PUBLIC_PEER_PATH=/
PUBLIC_PEER_SECURE=true
# Optional TURN relay for restrictive NATs. Use short-lived credentials in production.
PUBLIC_TURN_URL=
PUBLIC_TURN_USERNAME=
PUBLIC_TURN_CREDENTIAL=
