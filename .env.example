# Optional custom PeerJS signaling server. The public PeerJS cloud is the default.
PUBLIC_PEER_HOST=
PUBLIC_PEER_PORT=443
PUBLIC_PEER_PATH=/
PUBLIC_PEER_SECURE=true
# Optional TURN relay for restrictive NATs. Use short-lived credentials in production.
PUBLIC_TURN_URL=
PUBLIC_TURN_USERNAME=
PUBLIC_TURN_CREDENTIAL=
# Preferred: server-only coturn REST credentials, issued for 10 minutes by /api/ice.
# Use the same shared secret as coturn's static-auth-secret setting.
# Supply both UDP and TCP/TLS relay URLs when your service supports them.
TURN_URLS=
TURN_SECRET=

# Server-only Metered credentials (takes priority over coturn).
METERED_DOMAIN=spaceship-multiplayer.metered.live
METERED_API_KEY=
